---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../content/site.js';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${site.url}/#business`,
  name: site.brand.name,
  alternateName: site.brand.legalName,
  description: 'Empresa dominicana con más de 25 años en infraestructura civil, ingeniería electromecánica y servicios industriales. Operaciones a nivel nacional desde 1996.',
  url: site.url,
  logo: `${site.url}/assets/logo-full.svg`,
  image: `${site.url}${site.seo.defaultOgImage}`,
  foundingDate: '1996',
  telephone: site.contact.phoneTel,
  email: site.contact.email,
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    addressCountry: site.contact.countryCode,
    addressRegion: 'República Dominicana',
  },
  areaServed: {
    '@type': 'Country',
    name: 'República Dominicana',
  },
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '08:00',
    closes: '17:00',
  }],
  contactPoint: [{
    '@type': 'ContactPoint',
    telephone: site.contact.phoneTel,
    contactType: 'customer service',
    areaServed: 'DO',
    availableLanguage: ['Spanish'],
  }, {
    '@type': 'ContactPoint',
    telephone: site.contact.mobileTel,
    contactType: 'sales',
    areaServed: 'DO',
    availableLanguage: ['Spanish'],
  }],
  sameAs: [site.contact.whatsapp],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicios Multisemar',
    itemListElement: [
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Infraestructura Civil', description: 'Construcción, mantenimiento y obras civiles para proyectos residenciales, industriales y comerciales.' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Ingeniería Electromecánica', description: 'Servicios eléctricos, automatización, refrigeración y mantenimiento técnico.' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Servicios Industriales', description: 'Naves industriales, metalurgia, mecanizados y alquiler de grúa 17 toneladas.' } },
    ],
  },
};
---
<BaseLayout active="home" jsonLd={jsonLd}>

<!-- ============== HERO ============== -->
<section id="inicio" class="hero">
  <div class="wrap hero__wrap">
    <div class="hero__meta reveal">
      <span class="eyebrow"><span class="bar"></span>Multisemar · Desde 1996 · República Dominicana</span>
    </div>
    <div class="hero__grid">
      <div class="hero__copy reveal">
        <h1 class="h-display" style="font-size: clamp(44px, 6vw, 88px); line-height: 1.02;">
          Bienvenidos a <span class="h-italic-accent">Multisemar.</span>
        </h1>
        <p class="lede" style="margin-top:32px;">
          Más de 25 años entregando infraestructura civil, ingeniería electromecánica y servicios
          industriales a empresas, constructoras y particulares en todo el territorio dominicano.
        </p>
        <div class="hero__ctas">
          <a href="#cotizar" class="btn btn-red">Solicitar Cotización <span class="arrow">→</span></a>
          <a href="/services" class="btn btn-ghost">Explorar Servicios <span class="arrow">→</span></a>
        </div>
        <div class="hero__credentials">
          <div><span class="cred-num">1996</span><span class="cred-lbl">Año de fundación</span></div>
          <div><span class="cred-num">RD</span><span class="cred-lbl">Cobertura nacional</span></div>
          <div><span class="cred-num">3</span><span class="cred-lbl">Áreas de especialización</span></div>
        </div>
      </div>
      <aside class="hero__visual reveal">
        <div class="hero__photo imgph">
          <img class="imgph__img" src="https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&w=1600&q=80" alt="Grúa de servicio pesado en obra industrial" loading="lazy">
          <div class="imgph__caption">FOTO · Grúa de servicio pesado en obra industrial</div>
        </div>
        <div class="hero__photo hero__photo--small imgph imgph--paper">
          <img class="imgph__img" src="/images/multisemar-corte-metal.jpg" alt="Corte y metalurgia industrial Multisemar" loading="lazy">
          <div class="imgph__caption">FOTO · Corte y metalurgia industrial</div>
        </div>
        <div class="hero__badge">
          <span class="hero__badge-num">25</span>
          <span class="hero__badge-txt">años<br/>en operación<br/>continua</span>
        </div>
      </aside>
    </div>

    <div class="hero__stats reveal">
      <div class="hstat"><span class="hstat__n">25+</span><span class="hstat__l">Años de experiencia</span></div>
      <div class="hstat"><span class="hstat__n">100+</span><span class="hstat__l">Proyectos completados</span></div>
      <div class="hstat"><span class="hstat__n">3</span><span class="hstat__l">Áreas de especialización</span></div>
      <div class="hstat"><span class="hstat__n">RD</span><span class="hstat__l">Cobertura nacional</span></div>
    </div>
  </div>
</section>

<!-- ============== MARQUEE ============== -->
<div class="marquee" aria-hidden="true">
  <div class="marquee__track">
    <span class="marquee__item">Infraestructura Civil</span>
    <span class="marquee__item">Ingeniería Electromecánica</span>
    <span class="marquee__item">Servicios Industriales</span>
    <span class="marquee__item">Refrigeración y Cuartos Fríos</span>
    <span class="marquee__item">Generadores de Emergencia</span>
    <span class="marquee__item">Automatización y Domótica</span>
    <span class="marquee__item">Naves Industriales</span>
    <span class="marquee__item">Grúa de 17 Toneladas</span>
  </div>
</div>

<!-- ============== ABOUT ============== -->
<section id="nosotros" class="section">
  <div class="wrap">
    <div class="about__grid">
      <div class="about__left reveal">
        <span class="eyebrow"><span class="num">01</span><span class="bar"></span>Sobre nosotros</span>
        <h2 class="h-1" style="margin-top:24px;">
          Multisemar: servicios industriales construidos sobre <span class="h-italic-accent">ejecución impecable.</span>
        </h2>
      </div>
      <div class="about__right reveal">
        <p class="lede">
          Multisemar — Multiservicios Martínez — es una empresa dominicana con más de dos décadas
          ofreciendo servicios integrales de infraestructura civil, electromecánica y mantenimiento
          industrial en todo el territorio nacional.
        </p>
        <p style="margin-top:20px; color: var(--muted);">
          Combinamos experiencia técnica, calidad operativa y cobertura nacional para ejecutar
          proyectos residenciales, industriales y comerciales con responsabilidad técnica y compromiso
          ambiental.
        </p>
        <div class="about__pillars">
          <div><span class="pillar__num">01</span><h4 class="h-3">Alta calidad</h4><p>Estándares técnicos exigentes en cada servicio. Desde la cotización hasta la entrega.</p></div>
          <div><span class="pillar__num">02</span><h4 class="h-3">Experiencia</h4><p>Más de 25 años en proyectos civiles, electromecánicos e industriales en R.D.</p></div>
          <div><span class="pillar__num">03</span><h4 class="h-3">Compromiso ambiental</h4><p>Prácticas responsables con el entorno en cada obra y mantenimiento.</p></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============== SERVICES ============== -->
<section id="servicios" class="section section--paper2">
  <div class="wrap">
    <div class="svc-head reveal">
      <div>
        <span class="eyebrow"><span class="num">02</span><span class="bar"></span>Capacidades</span>
        <h2 class="h-1" style="margin-top:24px;">
          Tres áreas. <span class="h-italic-accent">Una sola</span> empresa.
        </h2>
      </div>
      <p class="lede" style="max-width:46ch;">
        De obra civil a electromecánica industrial — cubrimos el ciclo completo de un proyecto sin
        necesidad de múltiples contratistas, en toda la República Dominicana.
      </p>
    </div>

    <div class="svc-grid">
      <article class="svc reveal">
        <div class="svc__head"><span class="svc__num">01</span><span class="svc__tag">Civil</span></div>
        <h3 class="h-3">Infraestructura Civil</h3>
        <p>Construcción, mantenimiento y obras civiles para proyectos residenciales, industriales y comerciales.</p>
        <ul class="svc__list">
          <li>Construcción de casetas y localidades</li>
          <li>Cercados perimetrales</li>
          <li>Imbornales y registros sanitarios/eléctricos</li>
          <li>Reparación de estructuras metálicas</li>
          <li>Fabricación e instalación de canaletas</li>
          <li>Pintura, plomería y trabajos en madera</li>
          <li>Estructuras aligeradas</li>
          <li>Mantenimiento de áreas verdes y limpieza</li>
        </ul>
      </article>

      <article class="svc reveal">
        <div class="svc__head"><span class="svc__num">02</span><span class="svc__tag">Electromecánica</span></div>
        <h3 class="h-3">Ingeniería Electromecánica</h3>
        <p>Servicios eléctricos, automatización, refrigeración y mantenimiento técnico residencial e industrial.</p>
        <ul class="svc__list">
          <li>Facilidades eléctricas residenciales e industriales</li>
          <li>Automatización industrial y domótica</li>
          <li>Refrigeración: chillers, VRF, cuartos fríos</li>
          <li>Generadores de emergencia — instalación y mantenimiento</li>
          <li>Sistemas de purificación y ósmosis inversa</li>
          <li>Bombas, motores y maquinaria industrial</li>
          <li>Seguridad electrónica: cámaras y alarmas</li>
          <li>Ascensores y elevadores de carga</li>
        </ul>
      </article>

      <article class="svc reveal">
        <div class="svc__head"><span class="svc__num">03</span><span class="svc__tag">Industrial</span></div>
        <h3 class="h-3">Servicios Industriales</h3>
        <p>Soluciones especializadas para industrias, manufactura y proyectos de gran escala.</p>
        <ul class="svc__list">
          <li>Diseño y construcción de naves industriales</li>
          <li>Mantenimiento de naves industriales</li>
          <li>Metalurgia y mecanizados</li>
          <li>Corte computarizado</li>
          <li>Sistemas hidráulicos y neumáticos</li>
          <li>Ayudas visuales para aeropuertos</li>
          <li>Alquiler de grúa de 17 toneladas</li>
          <li>Asistencia operativa especializada</li>
        </ul>
      </article>
    </div>

    <div class="svc-foot reveal">
      <p>¿Necesita un alcance específico? Cotizamos proyectos integrales y servicios individuales.</p>
      <a href="/services" class="btn btn-ink">Ver catálogo completo <span class="arrow">→</span></a>
    </div>
  </div>
</section>

<!-- ============== WHY US ============== -->
<section id="por-que" class="section section--ink">
  <div class="wrap">
    <div class="why__head reveal">
      <span class="eyebrow"><span class="num" style="color:#fff;opacity:.5">03</span><span class="bar"></span>Por qué nosotros</span>
      <h2 class="h-1" style="margin-top:24px; max-width: 18ch;">
        25 años demostrando <span class="h-italic-accent">calidad.</span>
      </h2>
    </div>

    <div class="why__grid">
      <div class="why__left reveal">
        <div class="why__photo imgph">
          <img class="imgph__img" src="https://images.unsplash.com/photo-1521791136064-7986c2920216?auto=format&fit=crop&w=1600&q=80" alt="Equipo técnico en planta industrial" loading="lazy">
          <div class="imgph__caption">FOTO · Equipo técnico en planta industrial</div>
        </div>
        <div class="why__bigstats">
          <div><span class="stat__num" style="color:#fff;">25<span style="color:var(--red);">+</span></span><span class="stat__label">Años de operación continua</span></div>
          <div><span class="stat__num" style="color:#fff;">100<span style="color:var(--red);">+</span></span><span class="stat__label">Proyectos completados</span></div>
        </div>
      </div>

      <ul class="why__list reveal">
        <li><span class="why__n">01</span><div><strong>Más de 25 años de experiencia</strong><p>Operando en República Dominicana desde 1996 con más de 100 proyectos entregados.</p></div></li>
        <li><span class="why__n">02</span><div><strong>Tres áreas integradas</strong><p>Civil, electromecánica e industrial bajo un mismo equipo. Sin coordinación cruzada.</p></div></li>
        <li><span class="why__n">03</span><div><strong>Personal técnico capacitado</strong><p>Equipos propios con experiencia comprobada en cada disciplina.</p></div></li>
        <li><span class="why__n">04</span><div><strong>Cobertura nacional</strong><p>Operaciones en todo el territorio dominicano, incluyendo zonas industriales y turísticas.</p></div></li>
        <li><span class="why__n">05</span><div><strong>Compromiso ambiental</strong><p>Prácticas responsables con el entorno en cada obra y mantenimiento.</p></div></li>
        <li><span class="why__n">06</span><div><strong>Calidad operativa</strong><p>Estándares técnicos exigentes desde la cotización hasta la entrega final.</p></div></li>
        <li><span class="why__n">07</span><div><strong>Servicio mixto</strong><p>Atendemos clientes residenciales, comerciales e industriales en un mismo equipo.</p></div></li>
        <li><span class="why__n">08</span><div><strong>Grúa propia 17T</strong><p>Servicio de grúa en alquiler con operador, plan de izaje y cobertura nacional.</p></div></li>
      </ul>
    </div>
  </div>
</section>

<!-- ============== PROJECTS ============== -->
<section id="proyectos" class="section">
  <div class="wrap">
    <div class="prj-head reveal">
      <div>
        <span class="eyebrow"><span class="num">04</span><span class="bar"></span>Proyectos seleccionados</span>
        <h2 class="h-1" style="margin-top:24px;">Una muestra de lo <span class="h-italic-accent">entregado.</span></h2>
      </div>
      <a href="/projects" class="btn btn-ghost">Ver todos los proyectos <span class="arrow">→</span></a>
    </div>

    <div class="prj-grid">
      <a href="/projects" class="prj prj--lg reveal">
        <div class="prj__photo imgph">
          <img class="imgph__img" src="https://images.pexels.com/photos/32390903/pexels-photo-32390903.jpeg?auto=format&fit=crop&w=1920&q=80" alt="Nave industrial en construcción · estructura metálica" loading="lazy">
          <div class="imgph__caption">FOTO · Nave industrial en construcción · estructura metálica</div>
        </div>
        <div class="prj__meta">
          <span class="prj__tag">2024 · Industrial</span>
          <h3 class="h-3">Construcción de Nave Industrial</h3>
          <p>Desarrollo civil y estructural completo para centro de operaciones · Manufacturas del Caribe.</p>
        </div>
      </a>

      <a href="/projects" class="prj reveal">
        <div class="prj__photo imgph imgph--paper">
          <img class="imgph__img" src="https://images.pexels.com/photos/17072947/pexels-photo-17072947.jpeg?auto=compress&cs=tinysrgb&w=1600" alt="Cableado eléctrico industrial · modernización" loading="lazy">
          <div class="imgph__caption">FOTO · Cableado eléctrico industrial · modernización</div>
        </div>
        <div class="prj__meta">
          <span class="prj__tag">2023 · Manufactura</span>
          <h3 class="h-3">Modernización Eléctrica</h3>
          <p>Instalación industrial de alta capacidad y modernización de tableros · Grupo Industrial Romana.</p>
        </div>
      </a>

      <a href="/projects" class="prj reveal">
        <div class="prj__photo imgph">
          <img class="imgph__img" src="https://images.pexels.com/photos/11925463/pexels-photo-11925463.jpeg?auto=compress&cs=tinysrgb&w=1600" alt="Cableado eléctrico de alta capacidad · sistema de respaldo" loading="lazy">
          <div class="imgph__caption">FOTO · Cableado eléctrico de alta capacidad</div>
        </div>
        <div class="prj__meta">
          <span class="prj__tag">2024 · Hotelero</span>
          <h3 class="h-3">Sistema de Respaldo Eléctrico</h3>
          <p>Generador de emergencia con transferencia automática · Hoteles &amp; Resorts La Romana.</p>
        </div>
      </a>

      <a href="/projects" class="prj reveal">
        <div class="prj__photo imgph imgph--red">
          <img class="imgph__img" src="https://images.pexels.com/photos/13109834/pexels-photo-13109834.jpeg?auto=format&fit=crop&w=1200&q=80" alt="Sala de máquinas · refrigeración industrial" loading="lazy">
          <div class="imgph__caption">FOTO · Sala de máquinas · refrigeración industrial</div>
        </div>
        <div class="prj__meta">
          <span class="prj__tag">2023 · Manufactura</span>
          <h3 class="h-3">Mantenimiento Planta de Refrigeración</h3>
          <p>Mantenimiento integral de chillers y cuartos fríos · Manufacturas del Caribe.</p>
        </div>
      </a>

      <a href="/projects" class="prj prj--lg reveal">
        <div class="prj__photo imgph imgph--paper">
          <img class="imgph__img" src="https://images.unsplash.com/photo-1541888946425-d81bb19240f5?auto=format&fit=crop&w=1920&q=80" alt="Refuerzo estructural en infraestructura existente" loading="lazy">
          <div class="imgph__caption">FOTO · Refuerzo estructural en infraestructura existente</div>
        </div>
        <div class="prj__meta">
          <span class="prj__tag">2022 · Inmobiliario</span>
          <h3 class="h-3">Servicios Eléctricos Residenciales</h3>
          <p>Facilidades eléctricas e instalaciones integrales para 42 viviendas · Constructora Delmar S.R.L.</p>
        </div>
      </a>
    </div>
  </div>
</section>

<!-- ============== TESTIMONIALS ============== -->
<section class="section section--paper2">
  <div class="wrap">
    <div class="tst-head reveal">
      <span class="eyebrow"><span class="num">05</span><span class="bar"></span>Lo que dicen nuestros clientes</span>
      <h2 class="h-1" style="margin-top:24px; max-width: 18ch;">
        Confianza ganada <span class="h-italic-accent">obra por obra.</span>
      </h2>
    </div>

    <div class="tst-grid">
      <figure class="tst reveal">
        <blockquote>
          "Mantenimiento electromecánico continuo durante años. Equipo serio, respuesta rápida y trabajo bien hecho."
        </blockquote>
        <figcaption>
          <div class="tst__avatar"></div>
          <div>
            <strong>Grupo Industrial Romana</strong>
            <span>Cliente recurrente · Manufactura</span>
          </div>
        </figcaption>
      </figure>

      <figure class="tst reveal">
        <blockquote>
          "Servicios eléctricos e instalaciones integrales para nuestros proyectos. Cumplen con plazos y presupuesto."
        </blockquote>
        <figcaption>
          <div class="tst__avatar"></div>
          <div>
            <strong>Constructora Delmar S.R.L.</strong>
            <span>Proyectos inmobiliarios</span>
          </div>
        </figcaption>
      </figure>

      <figure class="tst reveal">
        <blockquote>
          "Servicio rápido de grúa, remodelaciones eléctricas y atención a emergencias con generadores. Cien por ciento confiables."
        </blockquote>
        <figcaption>
          <div class="tst__avatar"></div>
          <div>
            <strong>Hoteles & Resorts La Romana</strong>
            <span>Sector hotelero</span>
          </div>
        </figcaption>
      </figure>
    </div>

    <div class="tst-logos reveal">
      <span class="tst-logos__lbl">Han confiado en nosotros</span>
      <div class="tst-logos__row">
        <span class="logo-ph">CONSTRUCTORA DELMAR</span>
        <span class="logo-ph">GRUPO INDUSTRIAL ROMANA</span>
        <span class="logo-ph">MANUFACTURAS DEL CARIBE</span>
        <span class="logo-ph">HOTELES & RESORTS LA ROMANA</span>
      </div>
    </div>
  </div>
</section>

<!-- ============== CTA STRIP ============== -->
<section class="section section--navy" id="cta-strip">
  <div class="wrap">
    <div class="ctas reveal">
      <div>
        <span class="eyebrow" style="color:#fff;"><span class="num">06</span><span class="bar"></span>Hablemos</span>
        <h2 class="h-display" style="font-size: clamp(48px, 6.5vw, 96px); margin-top:24px; max-width: 14ch;">
          ¿Listo para su <span class="h-italic-accent">próximo proyecto?</span>
        </h2>
        <p class="lede" style="margin-top: 28px; max-width: 56ch;">
          Hable con nuestro equipo hoy y reciba una propuesta profesional adaptada a sus necesidades.
          Cobertura a nivel nacional en República Dominicana.
        </p>
        <div style="display:flex; flex-wrap:wrap; gap:14px; margin-top: 40px;">
          <a href="#cotizar" class="btn btn-red">Solicitar Cotización <span class="arrow">→</span></a>
          <a href="tel:+18095508815" class="btn btn-white">Llamar ahora · 809-550-8815</a>
        </div>
      </div>
      <div class="cta-side">
        <div class="cta-side__row"><span>Teléfono</span><strong>809-550-8815</strong></div>
        <div class="cta-side__row"><span>Celular</span><strong>829-523-8815</strong></div>
        <div class="cta-side__row"><span>Cobertura</span><strong>Nacional R.D.</strong></div>
        <div class="cta-side__row"><span>Cotización</span><strong>Sin costo</strong></div>
      </div>
    </div>
  </div>
</section>

<!-- ============== CONTACT ============== -->
<section id="contacto" class="section" style="padding-bottom: 0;">
  <div class="wrap">
    <div class="ct-head reveal">
      <span class="eyebrow"><span class="num">07</span><span class="bar"></span>Contacto</span>
      <h2 class="h-1" style="margin-top:24px;">Estamos para <span class="h-italic-accent">ayudarle.</span></h2>
      <p class="lede" style="margin-top:20px;">Complete el formulario o contáctenos directamente. Recibirá respuesta de un ingeniero — no un bot — en menos de 48 horas hábiles.</p>
    </div>

    <div class="ct-grid">
      <form class="ct-form reveal" id="cotizar" data-quote-form>
        <div class="ct-form__row">
          <label><span>Nombre completo *</span><input type="text" name="nombre" required placeholder="Ej. Juan Martínez" /></label>
          <label><span>Empresa</span><input type="text" name="empresa" placeholder="Razón social o nombre comercial" /></label>
        </div>
        <div class="ct-form__row">
          <label><span>Teléfono *</span><input type="tel" name="telefono" required placeholder="809-000-0000" /></label>
          <label><span>Correo electrónico *</span><input type="email" name="correo" required placeholder="nombre@empresa.com" /></label>
        </div>
        <label><span>Servicio requerido *</span>
          <select name="servicio" required>
            <option value="">Seleccione un servicio</option>
            <option>Infraestructura Civil</option>
            <option>Ingeniería Electromecánica</option>
            <option>Servicios Industriales</option>
            <option>Alquiler de grúa (17T)</option>
            <option>Mantenimiento de generadores</option>
            <option>Refrigeración / aire acondicionado</option>
