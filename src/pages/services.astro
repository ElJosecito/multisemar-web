---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Servicios — Multisemar · Multiservicios Martínez"
  description="Catálogo completo de servicios Multisemar: infraestructura civil, ingeniería electromecánica y servicios industriales en República Dominicana."
  active="services"
>

<!-- Page hero -->
<section class="section section--tight" style="padding-top: 64px;">
  <div class="wrap">
    <div class="page-hero reveal">
      <span class="eyebrow"><span class="bar"></span>Catálogo de servicios</span>
      <h1 class="h-display" style="font-size: clamp(40px, 6vw, 88px); margin-top: 24px;">
        Tres áreas. <span class="h-italic-accent">Una sola</span> empresa.
      </h1>
      <p class="lede" style="margin-top: 28px;">
        Multisemar opera como contratista integral en toda República Dominicana. Tres áreas de
        especialización con personal técnico capacitado, equipos propios y procedimientos documentados.
        Estos son los servicios — y cómo los entregamos.
      </p>
      <nav class="page-toc">
        <a href="#civil"><span>01</span>Infraestructura Civil</a>
        <a href="#electromecanica"><span>02</span>Ingeniería Electromecánica</a>
        <a href="#industrial"><span>03</span>Servicios Industriales</a>
      </nav>
    </div>
  </div>
</section>

<!-- ===== Service 01 — CIVIL ===== -->
<section class="section section--paper2" id="civil">
  <div class="wrap">
    <article class="svc-block reveal">
      <div class="svc-block__media imgph">
        <img class="imgph__img" src="https://images.pexels.com/photos/32390903/pexels-photo-32390903.jpeg?auto=format&fit=crop&w=1400&q=80" alt="Obra civil" loading="lazy">
        <span class="svc-block__num">01</span>
      </div>
      <div class="svc-block__body">
        <span class="eyebrow"><span class="num">01</span><span class="bar"></span>Obra civil</span>
        <h2 class="h-2" style="margin-top: 16px;">Infraestructura Civil</h2>
        <p class="lede" style="margin-top: 16px;">Construcción, mantenimiento y obras civiles. Desde casetas y cercados perimetrales hasta estructuras aligeradas y mantenimiento integral de espacios.</p>
        <div class="svc-block__cols">
          <div>
            <h4 class="svc-block__h4">Construcción</h4>
            <ul class="svc-block__list">
              <li>Construcción de casetas y localidades</li>
              <li>Cercados perimetrales</li>
              <li>Diseño y construcción de imbornales</li>
              <li>Registros sanitarios y eléctricos</li>
              <li>Estructuras aligeradas</li>
            </ul>
          </div>
          <div>
            <h4 class="svc-block__h4">Mantenimiento</h4>
            <ul class="svc-block__list">
              <li>Reparación de estructuras metálicas</li>
              <li>Fabricación e instalación de canaletas</li>
              <li>Pintura en general</li>
              <li>Plomería en general</li>
              <li>Trabajos en madera</li>
              <li>Mantenimiento de áreas verdes</li>
              <li>Limpieza interior y exterior</li>
            </ul>
          </div>
        </div>
      </div>
    </article>
  </div>
</section>

<!-- ===== Service 02 — ELECTROMECÁNICA ===== -->
<section class="section" id="electromecanica">
  <div class="wrap">
    <article class="svc-block svc-block--rev reveal">
      <div class="svc-block__media imgph">
        <img class="imgph__img" src="https://images.pexels.com/photos/17072947/pexels-photo-17072947.jpeg?auto=compress&cs=tinysrgb&w=1600" alt="Ingeniería electromecánica · cableado industrial" loading="lazy">
        <span class="svc-block__num">02</span>
      </div>
      <div class="svc-block__body">
        <span class="eyebrow"><span class="num">02</span><span class="bar"></span>Eléctrica · Mecánica</span>
        <h2 class="h-2" style="margin-top: 16px;">Ingeniería Electromecánica</h2>
        <p class="lede" style="margin-top: 16px;">El área más amplia de Multisemar. Servicios eléctricos, automatización, refrigeración, generadores y mantenimiento técnico para clientes residenciales, comerciales e industriales.</p>
        <div class="svc-block__cols svc-block__cols--3">
          <div>
            <h4 class="svc-block__h4">Eléctrica y automatización</h4>
            <ul class="svc-block__list">
              <li>Facilidades eléctricas residenciales</li>
              <li>Facilidades eléctricas industriales</li>
              <li>Reacondicionamiento de sistemas</li>
              <li>Automatización industrial</li>
              <li>Domótica</li>
              <li>Circuitos y tarjetas electrónicas</li>
              <li>Sistemas de puesta a tierra</li>
            </ul>
          </div>
          <div>
            <h4 class="svc-block__h4">Refrigeración y A/C</h4>
            <ul class="svc-block__list">
              <li>Refrigeración doméstica</li>
              <li>Refrigeración industrial</li>
              <li>Aires acondicionados</li>
              <li>Cuartos fríos</li>
              <li>Chillers</li>
              <li>Sistemas VRF</li>
              <li>Purificación y ósmosis inversa</li>
            </ul>
          </div>
          <div>
            <h4 class="svc-block__h4">Energía, equipos y seguridad</h4>
            <ul class="svc-block__list">
              <li>Generadores de emergencia — instalación</li>
              <li>Generadores — reparación y mantenimiento</li>
              <li>Bombas, motores y ventiladores</li>
              <li>Maquinarias industriales</li>
              <li>Cámaras y alarmas</li>
              <li>Ascensores y elevadores de carga</li>
              <li>Hidráulicos, neumáticos y ayudas visuales aéreas</li>
            </ul>
          </div>
        </div>
      </div>
    </article>
  </div>
</section>

<!-- ===== Service 03 — INDUSTRIAL ===== -->
<section class="section section--paper2" id="industrial">
  <div class="wrap">
    <article class="svc-block reveal">
      <div class="svc-block__media imgph">
        <img class="imgph__img" src="https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&w=1400&q=80" alt="Servicios industriales" loading="lazy">
        <span class="svc-block__num">03</span>
      </div>
      <div class="svc-block__body">
        <span class="eyebrow"><span class="num">03</span><span class="bar"></span>Industrial · Manufactura</span>
        <h2 class="h-2" style="margin-top: 16px;">Servicios Industriales</h2>
        <p class="lede" style="margin-top: 16px;">Soluciones especializadas para industrias y manufactura: diseño y construcción de naves industriales, metalurgia, mecanizados y servicios de izaje con grúa propia de 17 toneladas.</p>
        <div class="svc-block__cols">
          <div>
            <h4 class="svc-block__h4">Naves y manufactura</h4>
            <ul class="svc-block__list">
              <li>Diseño de naves industriales</li>
              <li>Construcción de naves industriales</li>
              <li>Mantenimiento de naves industriales</li>
              <li>Metalurgia</li>
              <li>Mecanizados</li>
              <li>Corte computarizado</li>
            </ul>
          </div>
          <div>
            <h4 class="svc-block__h4">Servicio de grúa</h4>
            <ul class="svc-block__list">
              <li>Grúa propia de 17 toneladas</li>
              <li>Servicio de alquiler</li>
              <li>Asistencia operativa</li>
              <li>Operador incluido</li>
              <li>Cobertura nacional</li>
            </ul>
            <a href="/#cotizar" class="btn btn-ink" style="margin-top: 20px;">Cotizar grúa <span class="arrow">→</span></a>
          </div>
        </div>
      </div>
    </article>
  </div>
</section>

<!-- CTA -->
<section class="section section--navy">
  <div class="wrap">
    <div class="ctas reveal">
      <div>
        <span class="eyebrow" style="color:#fff;"><span class="bar"></span>Hablemos</span>
        <h2 class="h-display" style="font-size: clamp(44px, 6vw, 88px); margin-top:24px; max-width: 16ch;">
          Cotice su <span class="h-italic-accent">próximo proyecto.</span>
        </h2>
        <p class="lede" style="margin-top: 24px; max-width: 56ch;">Cobertura a nivel nacional en República Dominicana. Cotización detallada según el alcance del proyecto.</p>
        <div style="display:flex; flex-wrap:wrap; gap:14px; margin-top: 36px;">
          <a href="/#cotizar" class="btn btn-red">Solicitar Cotización <span class="arrow">→</span></a>
          <a href="tel:+18095508815" class="btn btn-white">Llamar 809-550-8815</a>
        </div>
      </div>
      <div class="cta-side">
        <div class="cta-side__row"><span>Teléfono</span><strong>809-550-8815</strong></div>
        <div class="cta-side__row"><span>Celular</span><strong>829-523-8815</strong></div>
        <div class="cta-side__row"><span>Cobertura</span><strong>Nacional R.D.</strong></div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .page-hero { max-width: 920px; }
  .page-toc { display: flex; flex-wrap: wrap; gap: 0; margin-top: 56px; border-top: 1px solid var(--line); }
  .page-toc a { flex: 1; min-width: 240px; padding: 24px 28px 24px 0; display: flex; align-items: baseline; gap: 14px; border-bottom: 1px solid var(--line); font-family: var(--display); font-weight: 600; font-size: 18px; color: var(--ink-2); transition: color .15s ease, background .15s ease; }
  .page-toc a + a { border-left: 1px solid var(--line); padding-left: 28px; }
  @media (max-width: 800px) { .page-toc a + a { border-left: none; padding-left: 0; } }
  .page-toc a span { font-family: var(--sans); font-weight: 600; font-size: 12px; letter-spacing: 0.18em; color: var(--red); }
  .page-toc a:hover { background: var(--paper-2); color: var(--red); }

  .svc-block { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(32px, 5vw, 72px); align-items: start; padding: clamp(40px, 5vw, 64px) 0; }
  .svc-block--rev { grid-template-columns: 1fr 300px; }
  .svc-block--rev .svc-block__media { order: 2; }
  @media (max-width: 900px) { .svc-block, .svc-block--rev { grid-template-columns: 1fr; } .svc-block--rev .svc-block__media { order: 0; } }
  .svc-block__media { aspect-ratio: 4/5; position: sticky; top: 100px; }
  .svc-block--rev .svc-block__media { aspect-ratio: 4/5; width: 300px; }
  @media (max-width: 900px) { .svc-block__media, .svc-block--rev .svc-block__media { position: relative; top: auto; aspect-ratio: 16/10; width: auto; } }
  .svc-block__num { position: absolute; right: 20px; top: 18px; font-family: var(--display); font-weight: 700; font-size: 56px; color: #fff; opacity: 0.95; z-index: 3; text-shadow: 0 2px 8px rgba(0,0,0,0.4); }
  .svc-block__cols { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; margin-top: 36px; padding-top: 28px; border-top: 1px solid var(--line); }
  .svc-block__cols--3 { grid-template-columns: 1fr 1fr 1fr; gap: 28px; }
  @media (max-width: 1100px) { .svc-block__cols--3 { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 700px) { .svc-block__cols, .svc-block__cols--3 { grid-template-columns: 1fr; } }
  .svc-block__h4 { font-family: var(--sans); font-weight: 700; font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--red); margin-bottom: 16px; }
  .svc-block__list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 9px; font-size: 14px; color: var(--ink-2); line-height: 1.5; }
  .svc-block__list li { padding-left: 18px; position: relative; }
  .svc-block__list li::before { content: "+"; position: absolute; left: 0; color: var(--red); font-weight: 700; }

  .ctas { display: grid; grid-template-columns: 1.4fr 0.6fr; gap: clamp(32px, 5vw, 80px); align-items: end; }
  @media (max-width: 900px) { .ctas { grid-template-columns: 1fr; } }
  .cta-side { border-left: 1px solid rgba(255,255,255,0.18); padding-left: 32px; }
  @media (max-width: 900px) { .cta-side { border-left: none; border-top: 1px solid rgba(255,255,255,0.18); padding-left: 0; padding-top: 24px; } }
  .cta-side__row { display: flex; justify-content: space-between; align-items: baseline; padding: 18px 0; border-bottom: 1px dashed rgba(255,255,255,0.16); gap: 16px; }
  .cta-side__row span { font-family: var(--sans); font-weight: 600; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255,255,255,0.6); }
  .cta-side__row strong { font-family: var(--display); font-weight: 600; font-size: 16px; color: #fff; }
</style>

</BaseLayout>
