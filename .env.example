# ===============================================
# CONFIGURACIÓN SMTP PARA ENVÍO DE EMAILS
# ===============================================
# Estas variables configuran cómo tu aplicación envía emails

# SMTP_HOST: Servidor de correo saliente (SMTP)
# - Gmail: smtp.gmail.com
# - Outlook/Hotmail: smtp.office365.com  
# - Yahoo: smtp.mail.yahoo.com
# - Otros proveedores: consulta la documentación de tu proveedor
SMTP_HOST=smtp.gmail.com

# SMTP_PORT: Puerto del servidor SMTP
# - 587: Puerto estándar para SMTP con STARTTLS (recomendado)
# - 465: Puerto para SMTP con SSL/TLS
# - 25: Puerto básico (bloqueado por muchos proveedores)
SMTP_PORT=587

# SMTP_SECURE: Si usar SSL/TLS desde el inicio
# - false: Usar STARTTLS (para puerto 587) - MÁS COMÚN
# - true: Usar SSL/TLS directo (para puerto 465)
SMTP_SECURE=false

# SMTP_USER: Email desde el cual se enviarán los correos
# - Debe ser un email válido del proveedor configurado
# - Ejemplo: tucuenta@gmail.com
SMTP_USER=your_email@gmail.com

# SMTP_PASS: Contraseña o token de aplicación
# - Para Gmail: NO uses tu contraseña normal, usa "App Password"
# - Para Outlook: Puedes usar contraseña normal o App Password
# - Genera en: Configuración de seguridad de tu cuenta
SMTP_PASS=your_app_password

# RECIPIENT_EMAIL: Email que recibirá los formularios de contacto
# - Aquí llegarán todos los mensajes del formulario web
# - Puede ser diferente al SMTP_USER
RECIPIENT_EMAIL=multiserviciosmartinez@hotmail.com

# ===============================================
# GUÍA PASO A PASO - CONFIGURACIÓN CON GMAIL:
# ===============================================

# PASO 1: Habilitar verificación en 2 pasos en Gmail
# - Ve a https://myaccount.google.com/security
# - Busca "Verificación en 2 pasos" y actívala

# PASO 2: Generar contraseña de aplicación
# - En la misma página, busca "Contraseñas de aplicaciones"
# - Selecciona "Correo" y "Otro (nombre personalizado)"
# - Escribe "Formulario Web Multisemar" 
# - Google te dará una contraseña de 16 caracteres

# PASO 3: Configurar las variables
# SMTP_USER=tugmail@gmail.com          (tu email de Gmail)
# SMTP_PASS=abcd efgh ijkl mnop        (la contraseña de 16 caracteres)

# ===============================================
# OTROS PROVEEDORES DE EMAIL:
# ===============================================

# OUTLOOK/HOTMAIL:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tuhotmail@outlook.com (o @hotmail.com)
# SMTP_PASS=tu_contraseña_normal

# YAHOO MAIL:
# SMTP_HOST=smtp.mail.yahoo.com  
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tuyahoo@yahoo.com
# SMTP_PASS=contraseña_de_aplicación_yahoo

# ===============================================
# DESPLIEGUE EN VERCEL (PRODUCCIÓN):
# ===============================================
# 1. Ve a tu proyecto en Vercel Dashboard
# 2. Settings → Environment Variables
# 3. Agrega cada variable una por una:
#    - Name: SMTP_HOST,     Value: smtp.gmail.com
#    - Name: SMTP_PORT,     Value: 587  
#    - Name: SMTP_SECURE,   Value: false
#    - Name: SMTP_USER,     Value: tu_email@gmail.com
#    - Name: SMTP_PASS,     Value: tu_app_password
#    - Name: RECIPIENT_EMAIL, Value: multiserviciosmartinez@hotmail.com

# ===============================================
# IMPORTANTE - SEGURIDAD:
# ===============================================
# ❌ NUNCA subas el archivo .env real a GitHub
# ✅ Solo sube .env.example (sin datos reales)
# ✅ Agrega .env al archivo .gitignore
# ✅ En producción, usa las variables de entorno de Vercel

# ===============================================
# DESARROLLO LOCAL (OPCIONAL):
# ===============================================
# Para probar en desarrollo, crea un archivo .env.local con:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu_email_real@gmail.com
# SMTP_PASS=tu_app_password_real
# RECIPIENT_EMAIL=donde_quieres_recibir_emails@dominio.com

# ===============================================
# SIN CONFIGURACIÓN SMTP:
# =============================================== 
# El formulario funcionará sin estas variables:
# - Se mostrará mensaje de éxito al usuario
# - NO se enviará email real (útil para desarrollo)
# - Los datos se mostrarán en los logs del servidor